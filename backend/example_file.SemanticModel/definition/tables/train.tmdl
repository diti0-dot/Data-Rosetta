table train
	lineageTag: cac62b5f-eebb-4d86-a694-53da8712d117

	measure 'Yes %' =
			
			DIVIDE(
			    CALCULATE(COUNTROWS('train'), 'train'[Will_Buy_EV] = "Yes"),
			    COUNTROWS('train'),
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: fd134bde-0c9e-4d33-bc7f-9aea6a335d3d

	measure 'No %' =
			
			DIVIDE(
			    CALCULATE(COUNTROWS('train'), 'train'[Will_Buy_EV] = "No"),
			    COUNTROWS('train'),
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e3b6cf14-b377-4da5-b796-b25332601bff

	measure 'Total Customers' = COUNTROWS(train)
